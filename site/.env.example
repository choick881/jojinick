# 온담찬 사이트 환경변수 목록 (값은 Vercel → Settings → Environment Variables에만 넣는다. 이 파일에 실제 키를 적지 않는다)

# 필수: 주문 저장·결제 승인용 Supabase 서버 키 (sb_secret_...). 없으면 결제 대신 "결제 준비 중" 안내가 나온다
SUPABASE_SECRET_KEY=

# 선택: 비우면 토스 공식 문서의 공개 테스트 키를 쓴다(실제 돈이 오가지 않음). 운영 전환 때 live 키 한 쌍으로 바꾼다
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 선택: 비우면 lib/supabase-config.ts의 기본값(ondamchan 프로젝트 주소·공개 키)을 쓴다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 선택: 운영 도메인이 생기면 넣는다(사이트맵·대표 주소). 비우면 Vercel 운영 주소를 쓴다
NEXT_PUBLIC_SITE_URL=
